# Demo never calls Google. Set to n8n only after importing/configuring the workflow.
GENERATION_MODE=demo
HOST=127.0.0.1
PORT=3001
# Required if binding beyond loopback. Empty permits local-only access.
# Production Webhook URL (not the n8n editor or test URL).
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/formial-dashboard
# n8n Webhook Header Auth: x-formial-secret = this value.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Must be reachable from n8n. For local n8n use http://127.0.0.1:3000.
DASHBOARD_PUBLIC_URL=http://127.0.0.1:3001
JOB_TIMEOUT_MINUTES=65
# Keep local until MongoDB migration and the version 2 workflow are verified.
STORAGE_BACKEND=local
MONGODB_URI=
MONGODB_DATABASE=formial
MONGODB_COLLECTION=creatives-n8n
# Optional app-only resolver override if system DNS cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
N8N_PAYLOAD_VERSION=1
# Image bytes can move to Drive while metadata remains in MongoDB.
# Enable only after OAuth authorization and a verified image migration.
IMAGE_STORAGE_BACKEND=gridfs
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Google API key lives in n8n Header Auth credentials, not in this file or browser.
# Google credential: x-goog-api-key = raw company Gemini API key.
